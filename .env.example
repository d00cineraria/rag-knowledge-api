# LLMプロバイダ（既定 ollama = 完全ローカル・APIキー不要・ゼロ円）
# gemini に切り替えると品質は上がるが、無料枠の日次クォータ制限を受ける
LLM_PROVIDER=ollama

# --- Ollama（LLM_PROVIDER=ollama のとき使用。ローカルで `ollama serve` 起動済みが前提） ---
OLLAMA_BASE_URL=http://localhost:11434
# 事前に `ollama pull nomic-embed-text` `ollama pull qwen3.5:9b` が必要
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=qwen3.5:9b
# 評価スイートのLLM-as-judgeが使うモデル（未指定ならOLLAMA_CHAT_MODELを流用）
OLLAMA_JUDGE_MODEL=qwen3.5:9b

# --- Gemini（LLM_PROVIDER=gemini のとき使用） ---
GEMINI_API_KEY=your-gemini-api-key
# 無料枠はモデルごとに日次上限がある（例: gemini-2.5-flashは20req/日）。
# 無料枠で評価スイート(26問)を回す場合は gemini-2.5-flash-lite を推奨。
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# embedding次元（Gemini/Ollamaいずれもデフォルト768で揃っているため変更不要）
EMBED_DIM=768

# Database（単一ファイルのSQLite。sqlite-vec + FTS5 trigram）
SQLITE_PATH=./data/rag.db

# API
API_DEV_KEY=dev-local-key
MAX_UPLOAD_MB=20

# Reranker (bge-reranker-v2-m3, CPU, ~2.3GB初回ダウンロード)。
# 実測: Ollama embeddingの検索精度不足(recall@3 0.824)をtrueにするだけで0.973まで
# 引き上げ、Gemini単体(0.946)を上回る。ローカル運用ならtrue推奨（README参照）。
# 初回起動が重くなるため既定はfalseのまま。
RERANKER_ENABLED=false

# Ingest mode
# inline: Pythonがembeddingまで完結する（既定・クイックスタート向け）
# worker: Pythonはchunks/chunks_ftsへのINSERTまでで止め（status=embedding）、
#         embeddingは別プロセスのGoワーカー（worker/）が担う
INGEST_MODE=inline
