# Gemini API (embedding + generation)
GEMINI_API_KEY=your-gemini-api-key
# 無料枠はモデルごとに日次上限がある（例: gemini-2.5-flashは20req/日）。
# 無料枠で評価スイート(26問)を回す場合は gemini-2.5-flash-lite を推奨。
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768

# Database（単一ファイルのSQLite。sqlite-vec + FTS5 trigram）
SQLITE_PATH=./data/rag.db

# API
API_DEV_KEY=dev-local-key
MAX_UPLOAD_MB=20

# Reranker (bge-reranker-v2-m3, CPU). Heavy download on first run.
RERANKER_ENABLED=false
