# Gemini API (embedding + generation)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768

# Database
DATABASE_URL=postgresql://rag:rag_dev_password@db:5432/rag

# API
API_DEV_KEY=dev-local-key
MAX_UPLOAD_MB=20

# Reranker (bge-reranker-v2-m3, CPU). Heavy download on first run.
RERANKER_ENABLED=false
